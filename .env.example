PORT=3000
LLM_API_KEY=your_api_key_here
SHOW_REASONING=false

# ── Firebase (Admin-Configured fork) ─────────────────────────────────────────
# Public *web* app config returned by GET /api/auth/firebase-config. No project
# or key is shipped; set your own values. While FIREBASE_PROJECT_ID or
# FIREBASE_WEB_API_KEY is unset the endpoint returns 503 and advertises no
# project, and the verifier fails closed (generic 503). Safe placeholders only.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Server-side credential (never a web value, never committed): a path to a
# service-account JSON file, or inline JSON. Leave empty to use Application
# Default Credentials (GOOGLE_APPLICATION_CREDENTIALS).
FIREBASE_SERVICE_ACCOUNT=
